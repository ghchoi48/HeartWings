# Track only application sources, build inputs, and distribution notices.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/BUILDING.md
!/main.py
!/init_db.py
!/maeumnarae/
!/packaging/
!/resources/
!/requirements/
!/scripts/

# Keep existing local tests untracked; ship the new AI regression tests.
!/tests/
/tests/*
!/tests/test_ai.py
!/tests/test_ai_ui.py
!/tests/test_ai_harness.py
!/tests/test_ai_harness_ui.py

# Keep packaging inputs; local audits, tests, and validation reports are not build inputs.
/packaging/*
!/packaging/languages/
!/packaging/maeumnarae-data.spec
!/packaging/maeumnarae.spec
!/packaging/maeumnarae.iss
!/packaging/prepare_local_pyxlsb.py
!/packaging/prepare_pyxlsb_sources.py
!/packaging/release_sources.py
!/packaging/verify_certifi.py

/requirements/*
!/requirements/base.txt
!/requirements/desktop.txt
!/requirements/build.txt

/scripts/*
!/scripts/build_desktop.py
!/scripts/build_icons.py
!/scripts/build_splash.py
!/scripts/convert_ridibatang.py

# Local data and generated files are excluded even inside allowed folders.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.DS_Store
Thumbs.db
Desktop.ini
.env
.env.*
*.db
*.db-*
*.log
*.tmp
*.bak

# Local AI runtime artifacts are downloaded from pinned, verified releases.
/resources/ai/runtime/
!/scripts/prepare_ai_engine.py
